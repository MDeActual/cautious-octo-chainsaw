CORE_BACKEND_PORT=3003
# Entra API registration GUID, not api:// URI; delegated scope name.
API_AUDIENCE=00000000-0000-4000-8000-000000000001
TENANT_ISSUER=https://login.microsoftonline.com/{tenantid}/v2.0
API_REQUIRED_SCOPE=user_impersonation
# Explicit tenant GUID:object GUID membership. Empty list denies all assessment users.
ASSESSMENT_MEMBERS=[]
# Single-node pilot only: absolute path on a private encrypted volume, mode 0700.
# Leave empty to disable collection; never commit findings or tokens to source control.
ASSESSMENT_DATA_DIR=
# Confidential API credential obtained through an approved secret-management flow.
# Delegated SecurityEvents.Read.All must be consented separately by the tenant admin.
GRAPH_OBO_CLIENT_SECRET=
APP_INSIGHTS_CONNECTION_STRING=
